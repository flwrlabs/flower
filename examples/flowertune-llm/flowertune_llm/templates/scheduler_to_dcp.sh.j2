#!/usr/bin/env bash
set -euo pipefail

{{ env_setup }}

if [ -n "{{ workdir }}" ]; then
  cd "{{ workdir }}"
fi

export FLWR_TORCHTITAN_INPUT_DCP_DIR="{{ input_dcp_dir }}"
export FLWR_TORCHTITAN_INPUT_LAYERS_DIR="{{ input_layers_dir }}"
export FLWR_TORCHTITAN_DCP_CONVERSION_DIR="{{ dcp_conversion_dir }}"
export FLWR_TORCHTITAN_CONVERSION_PROFILE="{{ conversion_profile_path }}"
export FLWR_FLOWERTUNE_LLM_ROOT="{{ flowertune_llm_root }}"
export PYTHONPATH="${FLWR_FLOWERTUNE_LLM_ROOT}:${PYTHONPATH:-}"

{{ dcp_conversion_command }}

if [ ! -d "${FLWR_TORCHTITAN_DCP_CONVERSION_DIR}" ]; then
  echo "Layer-file to DCP conversion did not produce ${FLWR_TORCHTITAN_DCP_CONVERSION_DIR}" >&2
  exit 1
fi
if [ "${FLWR_TORCHTITAN_DCP_CONVERSION_DIR}" != "${FLWR_TORCHTITAN_INPUT_DCP_DIR}" ]; then
  ln -s "${FLWR_TORCHTITAN_DCP_CONVERSION_DIR}" "${FLWR_TORCHTITAN_INPUT_DCP_DIR}"
fi
