# Copy this file to .github/act/profiles/<profile>.vars.local.
#
# Use this profile when publishing test images to Docker Hub and Python packages
# to a non-production Python package repository such as TestPyPI or devpi.
DOCKER_IMAGE_REGISTRY=docker.io
DOCKER_IMAGE_REGISTRY_USER=<dockerhub-user>
DOCKER_IMAGE_NAMESPACE=<dockerhub-user>/flower-act

PYPI_REPOSITORY_NAME=testpypi
PYPI_REPOSITORY_URL=https://test.pypi.org/legacy/
PYPI_REPOSITORY_USERNAME=__token__
